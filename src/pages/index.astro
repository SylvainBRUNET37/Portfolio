---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.jsx";
import projects from "../data/projects.js";
import experiences from "../data/experiences.js";
import games from "../data/games.js";
import books from "../data/books.js";
import education from "../data/education.js";
import ProjectCard from "../components/ProjectCard.jsx";
import ExperienceCard from "../components/ExperienceCard.jsx";
import EducationCard from "../components/EducationCard";
import BookCard from "../components/BookCard";
import GameCard from "../components/GameCard";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Sylvain Brunet - Game Programmer"
  description="Portfolio of Sylvain Brunet, a game programmer based in Quebec, Canada. Master's in Computer Science & Game Development at Université de Sherbrooke. Projects, experiences and education."
>
  <Hero />

  <!-- Projects -->
  <section id="projects" class="mt-4">
    <details class="group" open>
      <summary class="flex cursor-pointer list-none items-center justify-between select-none">
        <div class="flex items-center gap-3">
          <span class="h-7 w-1.5 rounded-full bg-gradient-to-b from-indigo-500 to-sky-500" aria-hidden="true"></span>
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">Recent/current projects</h2>
        </div>
        <span class="text-slate-400 transition-transform group-open:rotate-180">▾</span>
      </summary>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
        {projects.slice(0, 3).map((p) => <ProjectCard project={p} />)}
      </div>
    </details>
  </section>

  <!-- Experiences -->
  <section id="experience" class="mt-12">
    <details class="group" open>
      <summary class="flex cursor-pointer list-none items-center justify-between select-none">
        <div class="flex items-center gap-3">
          <span class="h-7 w-1.5 rounded-full bg-gradient-to-b from-sky-500 to-indigo-500" aria-hidden="true"></span>
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">Recent/current experiences</h2>
        </div>
        <span class="text-slate-400 transition-transform group-open:rotate-180">▾</span>
      </summary>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
        {experiences.slice(0, 2).map((exp) => (
          <ExperienceCard project={exp} />
        ))}
      </div>
    </details>
  </section>

  <!-- Education (first two schools) -->
  <section id="education" class="mt-12">
    <details class="group" open>
      <summary class="flex cursor-pointer list-none items-center justify-between select-none">
        <div class="flex items-center gap-3">
          <span class="h-7 w-1.5 rounded-full bg-gradient-to-b from-indigo-500 to-sky-500" aria-hidden="true"></span>
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">Education</h2>
        </div>
        <span class="text-slate-400 transition-transform group-open:rotate-180">▾</span>
      </summary>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
        {education
          .find((g) => g.section === "School")
          .entries.slice(0, 2)
          .map((entry) => (
            <EducationCard entry={entry} />
          ))}
      </div>
    </details>
  </section>

  <!-- Books -->
  <section class="mt-12">
    <details open class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between select-none">
        <div class="flex items-center gap-3">
          <span class="h-7 w-1.5 rounded-full bg-gradient-to-b from-indigo-500 to-sky-500" aria-hidden="true"></span>
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">Recent/current readings</h2>
        </div>
        <span class="text-slate-400 transition-transform group-open:rotate-180">▾</span>
      </summary>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
        {books.slice(0, 3).map((book) => (
          <BookCard book={book} />
        ))}
      </div>
    </details>
  </section>

  <!-- Games -->
  <section class="mt-12">
    <details class="group" open>
      <summary class="flex cursor-pointer list-none items-center justify-between select-none">
        <div class="flex items-center gap-3">
          <span class="h-7 w-1.5 rounded-full bg-gradient-to-b from-indigo-500 to-sky-500" aria-hidden="true"></span>
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">Favorite games</h2>
        </div>
        <span class="text-slate-400 transition-transform group-open:rotate-180">▾</span>
      </summary>

      <div class="grid gap-6 [grid-template-columns:repeat(auto-fit,minmax(180px,1fr))] mt-6">
        {games.slice(0, 6).map((game) => (
          <GameCard game={game} />
        ))}
      </div>
    </details>
  </section>

  <!-- Contact -->
  <section id="contact" class="mt-32 py-16 border-t border-gray-200">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-semibold tracking-tight">Contact</h2>

      <!-- Contact cards -->
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/sylvainbrunet37/"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 rounded-xl border p-6 transition
                 hover:border-gray-400 hover:bg-gray-50"
        >
          <img
            src={`${base}images/icons/linkedin.png`}
            alt="LinkedIn"
            class="h-8 w-8 transition group-hover:scale-110"
          />
          <div class="text-left">
            <div class="text-lg font-medium">LinkedIn</div>
          </div>
        </a>

        <!-- Email -->
        <a
          href="mailto:sylvain.brunet37@gmail.com"
          class="group flex items-center gap-4 rounded-xl border p-6 transition
                 hover:border-gray-400 hover:bg-gray-50"
        >
          <img
            src={`${base}images/icons/gmail.png`}
            alt="Email"
            class="h-8 w-8 transition group-hover:scale-110"
          />
          <div class="text-left">
            <div class="text-lg font-medium">Email</div>
            <p class="text-sm text-gray-500">sylvain.brunet37@gmail.com</p>
          </div>
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/SylvainBRUNET37"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 rounded-xl border p-6 transition
                 hover:border-gray-400 hover:bg-gray-50"
        >
          <img
            src={`${base}images/icons/github.png`}
            alt="GitHub"
            class="h-8 w-8 transition group-hover:scale-110"
          />
          <div class="text-left">
            <div class="text-lg font-medium">GitHub</div>
          </div>
        </a>
      </div>

      <!-- CV cards -->
      <div class="mt-6">
        <div class="grid gap-4 sm:grid-cols-3 mx-auto">
          <!-- CV QC -->
          <a
            href={`${base}documents/CV - QC.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-xl border p-6 transition
                   hover:border-gray-400 hover:bg-gray-50"
          >
            <img
              src={`${base}images/icons/qc.png`}
              alt="CV Quebec"
              class="h-8 w-8 transition group-hover:scale-110"
            />
            <div class="text-left">
              <div class="text-lg font-medium">CV - Québecois (FR)</div>
            </div>
          </a>

          <!-- CV FR -->
          <a
            href={`${base}documents/CV - FR.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-xl border p-6 transition
                   hover:border-gray-400 hover:bg-gray-50"
          >
            <img
              src={`${base}images/icons/fr.png`}
              alt="CV French"
              class="h-8 w-8 transition group-hover:scale-110"
            />
            <div class="text-left">
              <div class="text-lg font-medium">CV - Français</div>
            </div>
          </a>

          <!-- CV EN -->
          <a
            href={`${base}documents/CV - EN.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-xl border p-6 transition
                   hover:border-gray-400 hover:bg-gray-50"
          >
            <img
              src={`${base}images/icons/en.png`}
              alt="CV English"
              class="h-8 w-8 transition group-hover:scale-110"
            />
            <div class="text-left">
              <div class="text-lg font-medium">CV - English</div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>