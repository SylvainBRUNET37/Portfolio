---
import BaseLayout from "../layouts/BaseLayout.astro";
import projects from "../data/projects.js";
import ProjectCard from "../components/ProjectCard.jsx";
---

<BaseLayout
  title="Projects - Sylvain Brunet"
  description="Main projects of Sylvain Brunet: Unreal Engine 5 multiplayer horror game, custom C++ game engine, CHIP-8 emulator, genetic algorithms and more."
>
  <section class="mt-4">
    <div class="flex items-center gap-3 mb-6">
      <span class="h-9 w-1.5 rounded-full bg-gradient-to-b from-indigo-500 to-sky-500" aria-hidden="true"></span>
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Main Projects</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map(p => (
        <ProjectCard project={p} />
      ))}
    </div>
  </section>
</BaseLayout>
