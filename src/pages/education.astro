---
import BaseLayout from "../layouts/BaseLayout.astro";
import education from "../data/education.js";
import EducationCard from "../components/EducationCard.jsx";
---

<BaseLayout
  title="Education - Sylvain Brunet"
  description="Education of Sylvain Brunet: Master's in Computer Science for Video Games at Université de Sherbrooke and Engineering Degree in Computer Science at Polytech Tours."
>
  <!-- School & online courses -->
  <section class="mt-4">
    <div class="flex items-center gap-3 mb-6">
      <span class="h-9 w-1.5 rounded-full bg-gradient-to-b from-sky-500 to-indigo-500" aria-hidden="true"></span>
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Education</h2>
    </div>

    {education.map((group) => (
      <section class="mt-12">
        <details class="group" open>
          <summary class="flex cursor-pointer list-none items-center justify-between select-none">
            <div class="flex items-center gap-3">
              <span class="h-8 w-1.5 rounded-full bg-gradient-to-b from-indigo-500 to-sky-500" aria-hidden="true"></span>
              <h3 class="text-3xl font-bold text-slate-900">
                {group.section}
              </h3>
            </div>
            <span class="text-slate-400 transition-transform group-open:rotate-180">
              ▾
            </span>
          </summary>

          <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
            {group.entries.map((entry) => (
              <EducationCard entry={entry} />
            ))}
          </div>
        </details>
      </section>
    ))}
  </section>
</BaseLayout>