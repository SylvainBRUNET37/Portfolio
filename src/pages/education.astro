---
import BaseLayout from "../layouts/BaseLayout.astro";
import education from "../data/education.js";
import EducationCard from "../components/EducationCard.jsx";
---

<BaseLayout>
  <!-- School & online courses -->
  <section class="mt-4">
    <div class="flex items-center gap-3 mb-6">
      <span class="h-9 w-1.5 rounded-full bg-gradient-to-b from-indigo-500 to-sky-500" aria-hidden="true"></span>
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Education</h2>
    </div>

    {education.map((group) => (
      <section class="mt-12">
        <details class="group border-t border-slate-200 pt-6" open>
          <summary class="cursor-pointer list-none flex-row items-center justify-between text-3xl font-bold select-none">
            {group.section}
            <span class="ml-3 text-sm text-slate-500">
              ({group.entries.length})
            </span>
            <span class="transition-transform group-open:rotate-180 text-slate-400">
              ▾
            </span>
          </summary>

          <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
            {group.entries.map((entry) => (
              <EducationCard entry={entry} />
            ))}
          </div>
        </details>
      </section>
    ))}
  </section>
</BaseLayout>