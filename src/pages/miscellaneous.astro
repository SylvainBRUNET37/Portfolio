---
import BaseLayout from "../layouts/BaseLayout.astro";
import books from "../data/books.js";
import games from "../data/games.js";
import conferences from "../data/conferences.js";

import BookCard from "../components/BookCard.jsx";
import GameCard from "../components/GameCard.jsx";
import ConferenceCard from "../components/ConferenceCard.jsx";
---

<BaseLayout
  title="Interests - Sylvain Brunet"
  description="Interests of Sylvain Brunet: favorite games, readings and a curated archive of C++ and game development talks and conferences."
>
  <!-- Games -->
  <div class="mt-4 flex items-center gap-3 mb-2">
    <span class="h-9 w-1.5 rounded-full bg-gradient-to-b from-indigo-500 to-sky-500" aria-hidden="true"></span>
    <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Interests</h2>
  </div>

  <section class="mt-8">
    <details class="group" open>
      <summary class="flex cursor-pointer list-none items-center justify-between select-none">
        <div class="flex items-center gap-3">
          <span class="h-8 w-1.5 rounded-full bg-gradient-to-b from-indigo-500 to-sky-500" aria-hidden="true"></span>
          <h2 class="text-3xl font-bold text-slate-900">Favorite games</h2>
        </div>
        <span class="text-slate-400 transition-transform group-open:rotate-180">▾</span>
      </summary>

      <div class="grid gap-6 [grid-template-columns:repeat(auto-fit,minmax(180px,1fr))] mt-6">
      {games.map(game => (
        <GameCard game={game} />
      ))}
       </div>
    </details>
  </section>

  <!-- Books -->
  <section class="mt-12">
    <details open class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between select-none">
        <div class="flex items-center gap-3">
          <span class="h-8 w-1.5 rounded-full bg-gradient-to-b from-indigo-500 to-sky-500" aria-hidden="true"></span>
          <h2 class="text-3xl font-bold text-slate-900">Books archive</h2>
        </div>
        <span class="text-slate-400 transition-transform group-open:rotate-180">▾</span>
      </summary>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
        {books.map(book => (
          <BookCard book={book} />
        ))}
      </div>
    </details>
  </section>

  <!-- Conferences -->
  <section class="mt-12">
    <details class="group" open>
      <summary class="flex cursor-pointer list-none items-center justify-between select-none">
        <div class="flex items-center gap-3">
          <span class="h-8 w-1.5 rounded-full bg-gradient-to-b from-indigo-500 to-sky-500" aria-hidden="true"></span>
          <h2 class="text-3xl font-bold text-slate-900">Talks & videos archive</h2>
        </div>
        <span class="text-slate-400 transition-transform group-open:rotate-180">▾</span>
      </summary>

      <div class="mt-10 space-y-10">
        {conferences.map(section => (
          <details class="group" open>
            <summary class="flex cursor-pointer list-none items-center justify-between select-none">
              <div class="flex items-center gap-3">
                <span class="h-5 w-1.5 rounded-full bg-gradient-to-b from-indigo-500 to-sky-500" aria-hidden="true"></span>
                <h3 class="text-xl font-semibold text-slate-900">
                  {section.section}
                  <span class="ml-2 text-sm font-normal text-slate-500">
                    ({section.conferences.length})
                  </span>
                </h3>
              </div>
              <span class="text-slate-400 transition-transform group-open:rotate-180">
                ▾
              </span>
            </summary>

            <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
              {section.conferences.map(conf => (
                <ConferenceCard conference={conf} />
              ))}
            </div>
          </details>
        ))}
      </div>
    </details>
  </section>

</BaseLayout>